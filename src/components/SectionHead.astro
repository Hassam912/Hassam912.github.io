---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  href?: string;
  hrefLabel?: string;
}
const { eyebrow, title, lede, href, hrefLabel } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-6 border-t pt-6" style="border-color: var(--rule);">
  <div class="max-w-xl">
    <p class="eyebrow">{eyebrow}</p>
    <h2
      class="mt-3 text-2xl leading-tight tracking-tight md:text-[1.75rem]"
      style="font-family: var(--font-serif); color: var(--ink);"
    >
      {title}
    </h2>
    {lede && <p class="mt-3 text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">{lede}</p>}
  </div>
  {
    href && (
      <a href={href} class="link-underline shrink-0 text-sm font-medium" style="color: var(--accent-ink);">
        {hrefLabel ?? 'View all'} &rarr;
      </a>
    )
  }
</div>
