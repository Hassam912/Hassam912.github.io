---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="contact" class="mt-24 border-t md:mt-32" style="border-color: var(--rule); background: var(--paper-2);">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div>
        <p class="eyebrow flex items-center gap-2.5"><span class="signal-dot" aria-hidden="true"></span>Contact</p>
        <h2
          class="mt-4 max-w-lg text-[1.9rem] leading-[1.15] tracking-[-0.015em] md:text-[2.25rem]"
          style="font-family: var(--font-display); color: var(--ink); font-weight: 650;"
        >
          Looking for someone who can model it and ship it?
        </h2>
        <p class="mt-4 max-w-md text-[0.98rem] leading-relaxed" style="color: var(--ink-2);">
          I’m {site.status.charAt(0).toLowerCase() + site.status.slice(1)}. Email is the fastest way to reach me.
        </p>
        <p class="num mt-5 select-all text-[1rem]" style="color: var(--ink); font-weight: 500;">{site.email}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">Email me</a>
          <a href={site.linkedin} class="btn btn-ghost">LinkedIn</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 md:justify-items-end">
        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href={site.linkedin} class="link link-quiet">LinkedIn</a></li>
            <li><a href={site.github} class="link link-quiet">GitHub</a></li>
            <li><a href={site.resume} class="link link-quiet">Resume (PDF)</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Site</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/#work" class="link link-quiet">Work</a></li>
            <li><a href="/#experience" class="link link-quiet">Experience</a></li>
            <li><a href="/about/" class="link link-quiet">About</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
      style="border-color: var(--rule); color: var(--ink-3);"
    >
      <p>© {year} {site.name}</p>
      <p style="font-family: var(--font-mono);">{site.location}</p>
    </div>
  </div>
</footer>
