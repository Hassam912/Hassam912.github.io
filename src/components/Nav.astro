---
import { site } from '../data/site';

const path = Astro.url.pathname;
const links = [
  /* Scrolls to the work section on the homepage; from any other page it goes
     home first and lands there. `match` drives the active state, since the
     hash never appears in the pathname. */
  { href: '/#work', label: 'Work', match: '/projects' },
  { href: '/about', label: 'About' },
  { href: site.resume, label: 'Résumé', external: true },
];
const isActive = (l: { href: string; match?: string }) => {
  const p = l.match ?? l.href;
  return path === p || path.startsWith(p + '/');
};
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur-md"
  style="border-color: var(--rule); background: color-mix(in srgb, var(--paper) 85%, transparent);"
>
  <nav class="wrap flex h-14 items-center justify-between gap-4">
    <a href="/" class="group flex items-baseline gap-2.5 min-w-0">
      <span class="text-[0.9375rem] font-semibold tracking-tight truncate" style="color: var(--ink);"
        >{site.name}</span
      >
      <span class="eyebrow hidden sm:inline truncate">Analytics · Optimization</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded px-2.5 py-1.5 text-[0.8125rem] font-medium transition-colors"
            style={`color: ${isActive(l) && !l.external ? 'var(--accent-ink)' : 'var(--ink-2)'};`}
            data-nav
          >
            {l.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle colour theme"
        class="ml-1 grid h-8 w-8 place-items-center rounded-full border transition-colors"
        style="border-color: var(--rule); color: var(--ink-2);"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  [data-nav]:hover {
    background: var(--paper-2);
  }
  #theme-toggle:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>
