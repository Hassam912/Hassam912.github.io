---
import type { CollectionEntry } from 'astro:content';
import CardThumb from './CardThumb.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Featured cards get the full treatment; compact ones are index rows. */
  variant?: 'feature' | 'compact';
}
const { project, variant = 'feature' } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}`;

/** Featured projects that have a real chart to preview. */
const withThumb = new Set([
  'hospital-meal-planning-milp',
  'soccer-transfer-value-model',
  'hopefield-inventory-optimization',
  'kaggle-house-prices',
]);
const hasThumb = withThumb.has(project.id);
---

{
  variant === 'feature' ? (
    <a
      href={href}
      class="group relative flex flex-col overflow-hidden border p-7 transition-all md:p-8"
      style="border-color: var(--rule); background: var(--paper-3); box-shadow: var(--shadow); border-radius: var(--radius-lg);"
      data-card
    >
      <div class="flex items-baseline justify-between gap-4">
        <span class="eyebrow whitespace-nowrap" style="color: var(--accent-ink);">
          {d.category}
        </span>
        <span class="eyebrow truncate text-right">{d.context}</span>
      </div>

      {hasThumb && (
        <div
          class="mt-5 border px-4 py-3.5"
          style="border-color: var(--rule); background: var(--paper-2); border-radius: var(--radius);"
        >
          <CardThumb id={project.id} />
        </div>
      )}

      <h3
        class="mt-5 text-[1.375rem] leading-snug tracking-tight md:text-2xl"
        style="font-family: var(--font-display); color: var(--ink); font-weight: 700;"
      >
        {d.title}
      </h3>
      <p class="mt-2.5 text-[0.9375rem] font-medium leading-snug" style="color: var(--accent-ink);">
        {d.tagline}
      </p>
      <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">
        {d.summary}
      </p>

      {d.metrics.length > 0 && (
        <dl class="mt-7 grid grid-cols-3 gap-4 border-t pt-5" style="border-color: var(--rule);">
          {d.metrics.slice(0, 3).map((m) => (
            <div>
              <dt class="sr-only">{m.label}</dt>
              <dd>
                <span
                  class="block text-lg leading-none tracking-tight"
                  style="font-family: var(--font-mono); color: var(--ink); font-weight: 600;"
                >
                  {m.value}
                </span>
                <span class="mt-1.5 block text-[0.6875rem] leading-tight" style="color: var(--ink-3);">
                  {m.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      )}

      <div class="mt-6 flex flex-wrap gap-1.5">
        {d.stack.slice(0, 5).map((s) => (
          <span class="chip">{s}</span>
        ))}
      </div>

      <span
        class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium"
        style="color: var(--accent-ink);"
      >
        Read the case study
        <svg
          class="transition-transform group-hover:translate-x-1"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </span>
    </a>
  ) : (
    <a
      href={href}
      class="group grid gap-3 border-t py-6 transition-colors sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
      style="border-color: var(--rule);"
      data-row
    >
      <div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="text-lg tracking-tight" style="font-family: var(--font-display); color: var(--ink); font-weight: 700;">
            {d.title}
          </h3>
          <span class="eyebrow" style="color: var(--accent-ink);">
            {d.category}
          </span>
        </div>
        <p class="mt-1.5 max-w-2xl text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">
          {d.tagline}
        </p>
      </div>
      <div class="flex items-center gap-3 sm:justify-end">
        <span class="eyebrow whitespace-nowrap">{d.timeline}</span>
        <svg
          class="shrink-0 transition-transform group-hover:translate-x-1"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: var(--accent-ink);"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </div>
    </a>
  )
}

<style>
  [data-card]:hover {
    transform: translateY(-4px);
    border-color: var(--accent-border);
    box-shadow: var(--shadow-lift) !important;
  }
  [data-row]:hover {
    background: var(--paper-2);
  }
</style>
