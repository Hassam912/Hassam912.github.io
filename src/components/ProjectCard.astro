---
import type { CollectionEntry } from 'astro:content';
import CardThumb from './CardThumb.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Featured cards get the full treatment; compact ones are index rows. */
  variant?: 'feature' | 'compact';
  /** Position in the featured list — even/odd flips which side the chart sits on. */
  index?: number;
}
const { project, variant = 'feature', index = 0 } = Astro.props;
const flip = index % 2 === 1;
const d = project.data;
const href = `/projects/${project.id}`;

/** Featured projects that have a real chart to preview. */
const withThumb = new Set([
  'hospital-meal-planning-milp',
  'soccer-transfer-value-model',
  'hopefield-inventory-optimization',
  'kaggle-house-prices',
  'car-insurance-claim-predictor',
  'cowlar-billing-system',
]);
const hasThumb = withThumb.has(project.id);
---

{
  variant === 'feature' ? (
    <a
      href={href}
      class:list={["snap-card group relative grid items-stretch gap-8 overflow-hidden border p-7 transition-all md:p-11 lg:gap-14", hasThumb ? "lg:grid-cols-[1.05fr_0.95fr]" : "lg:grid-cols-1"]}
      style="border-color: var(--rule); background: var(--paper-3); box-shadow: var(--shadow); border-radius: var(--radius-lg);"
      id={`project-${project.id}`}
      data-card
      data-flip={flip ? '' : undefined}
    >
      {/* Words */}
      <div class="flex flex-col justify-center lg:order-1" style={flip ? 'order: 2' : undefined}>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="eyebrow whitespace-nowrap" style="color: var(--accent-ink);">
            {d.category}
          </span>
          <span class="eyebrow">{d.context}</span>
        </div>

        <h3
          class="mt-5 text-[1.75rem] leading-[1.15] tracking-tight md:text-[2.25rem]"
          style="font-family: var(--font-display); color: var(--ink); font-weight: 700;"
        >
          {d.title}
        </h3>
        <p class="mt-4 text-[1.0625rem] font-semibold leading-snug md:text-[1.125rem]" style="color: var(--accent-ink);">
          {d.tagline}
        </p>
        <p class="mt-5 max-w-xl text-[0.9375rem] leading-relaxed md:text-[1rem]" style="color: var(--ink-2);">
          {d.summary}
        </p>

        {d.metrics.length > 0 && (
          <dl class="mt-8 grid grid-cols-3 gap-5 border-t pt-6" style="border-color: var(--rule);">
            {d.metrics.slice(0, 3).map((m) => (
              <div>
                <dt class="sr-only">{m.label}</dt>
                <dd>
                  <span
                    class="block text-[1.5rem] leading-none tracking-tight md:text-[1.75rem]"
                    style="font-family: var(--font-mono); color: var(--accent-ink); font-weight: 600;"
                  >
                    {m.value}
                  </span>
                  <span class="mt-2 block text-[0.75rem] leading-tight" style="color: var(--ink-3);">
                    {m.label}
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        )}

        <div class="mt-7 flex flex-wrap gap-2">
          {d.stack.slice(0, 5).map((s) => (
            <span class="chip">{s}</span>
          ))}
        </div>

        <span
          class="mt-8 inline-flex w-fit items-center gap-2 self-start rounded-full px-6 py-3 text-[0.9375rem] font-semibold text-white transition-all"
          style="background: linear-gradient(135deg, #fb923c, #ea580c);"
          data-readcta
        >
          Read the case study
          <svg
            class="transition-transform group-hover:translate-x-1"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </span>
      </div>

      {/* Chart */}
      {hasThumb && (
        <div
          class="flex h-full flex-col justify-center border p-6 md:p-8 lg:order-2"
          style={`border-color: var(--rule); background: var(--paper-2); border-radius: var(--radius);${flip ? ' order: 1;' : ''}`}
        >
          <CardThumb id={project.id} />
        </div>
      )}
    </a>
  ) : (
    <a
      href={href}
      class="group grid gap-3 border-t py-6 transition-colors sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
      style="border-color: var(--rule);"
      data-row
    >
      <div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="text-lg tracking-tight" style="font-family: var(--font-display); color: var(--ink); font-weight: 700;">
            {d.title}
          </h3>
          <span class="eyebrow" style="color: var(--accent-ink);">
            {d.category}
          </span>
        </div>
        <p class="mt-1.5 max-w-2xl text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">
          {d.tagline}
        </p>
      </div>
      <div class="flex items-center gap-3 sm:justify-end">
        <span class="eyebrow whitespace-nowrap">{d.timeline}</span>
        <svg
          class="shrink-0 transition-transform group-hover:translate-x-1"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: var(--accent-ink);"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </div>
    </a>
  )
}

<style>
  [data-card]:hover {
    transform: translateY(-4px);
    border-color: var(--accent-border);
    box-shadow: var(--shadow-lift) !important;
  }
  [data-row]:hover {
    background: var(--paper-2);
  }
</style>
