---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
---

<Base
  title={`Work — ${site.name}`}
  description="Optimization, machine learning, business intelligence and automation projects, each written up as a full case study."
>
  <section class="wrap pt-16 pb-10 md:pt-24">
    <p class="eyebrow">Work</p>
    <h1
      class="mt-4 max-w-3xl text-[2.25rem] leading-[1.1] tracking-[-0.02em] md:text-5xl"
      style="font-family: var(--font-serif); color: var(--ink); font-weight: 400;"
    >
      Every project here started with a decision someone had to make.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: var(--ink-2);">
      Written up in full — the business question, the data, the method and the trade-offs I chose,
      the result, and what I'd do differently. Including the parts that went wrong.
    </p>
  </section>

  {/* ── Filter ───────────────────────────────────────────────────────── */}
  <section class="wrap">
    <div
      class="flex flex-wrap gap-2 border-y py-4"
      style="border-color: var(--rule);"
      role="group"
      aria-label="Filter projects by category"
    >
      {
        categories.map((c, i) => (
          <button
            type="button"
            class="rounded-full border px-3.5 py-1.5 text-[0.8125rem] font-medium transition-colors"
            style="border-color: var(--rule); color: var(--ink-2);"
            data-filter={c}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {c}
          </button>
        ))
      }
    </div>
  </section>

  {/* ── Grid ─────────────────────────────────────────────────────────── */}
  <section class="wrap mt-8">
    <div class="grid gap-5 md:grid-cols-2" id="grid">
      {
        projects.map((p) => (
          <div data-category={p.data.category}>
            <ProjectCard project={p} />
          </div>
        ))
      }
    </div>
    <p class="mt-10 hidden text-sm" id="empty" style="color: var(--ink-3);">
      Nothing in that category yet.
    </p>
  </section>
</Base>

<style>
  [data-filter]:hover {
    background: var(--paper-2);
  }
  [data-filter][aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper) !important;
  }
  #grid > div > a {
    height: 100%;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#grid > [data-category]');
  const empty = document.getElementById('empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const want = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      let shown = 0;
      cards.forEach((card) => {
        const match = want === 'All' || card.dataset.category === want;
        card.hidden = !match;
        if (match) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    });
  });
</script>
