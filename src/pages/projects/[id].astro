---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Context', value: d.context },
  { label: 'Role', value: d.role },
  { label: 'Timeline', value: d.timeline },
];
---

<Base title={`${d.title} — ${site.name}`} description={d.summary} progress>
  <article>
    {/* ── Header ───────────────────────────────────────────────────── */}
    <header class="wrap pt-14 pb-12 md:pt-20">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-1.5" style="color: var(--ink-3);">
          <li><a href="/#work" class="link">Work</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="truncate">{d.category}</li>
        </ol>
      </nav>

      <p class="eyebrow mt-8">{d.context}</p>
      <h1
        class="mt-3 max-w-3xl text-[2.1rem] leading-[1.1] tracking-[-0.022em] md:text-[3rem]"
        style={`font-family: var(--font-display); color: var(--ink); font-weight: 650; view-transition-name: title-${project.id};`}
      >
        {d.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: var(--ink-2);">
        {d.tagline}
      </p>

      <dl class="mt-10 grid gap-6 border-t pt-6 sm:grid-cols-3" style="border-color: var(--rule);">
        {
          facts.map((f) => (
            <div>
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-2 text-sm leading-snug" style="color: var(--ink);">
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap gap-1.5">
        {d.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
    </header>

    {/* ── Metrics ──────────────────────────────────────────────────── */}
    {
      d.metrics.length > 0 && (
        <section class="wrap">
          <dl
            class="grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-3"
            style="border-color: var(--rule); background: var(--rule);"
          >
            {d.metrics.map((m) => (
              <div class="p-6" style="background: var(--paper-3);">
                <dd class="num text-3xl leading-none" style="color: var(--accent);">
                  {m.value}
                </dd>
                <dt class="mt-3 text-[0.8125rem] leading-snug" style="color: var(--ink-2);">
                  {m.label}
                </dt>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {/* ── At a glance ──────────────────────────────────────────────── */}
    <section class="wrap mt-14">
      <div class="grid gap-8 rounded-2xl border p-7 md:grid-cols-3 md:p-9" style="border-color: var(--rule); background: var(--paper-2);">
        {
          (
            [
              ['Problem', d.glance.problem],
              ['Approach', d.glance.approach],
              ['Result', d.glance.result],
            ] as const
          ).map(([label, body]) => (
            <div>
              <p class="eyebrow">
                {label}
              </p>
              <p class="mt-3 text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">
                {body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ── Body ─────────────────────────────────────────────────────── */}
    <div class="wrap mt-16">
      <div class="mx-auto max-w-[42rem]">
        <div class="prose-case">
          <Content />
        </div>

        {
          d.links.length > 0 && (
            <div class="mt-14 border-t pt-6" style="border-color: var(--rule);">
              <p class="eyebrow">Links</p>
              <ul class="mt-4 space-y-2">
                {d.links.map((l) => (
                  <li>
                    <a class="link inline-flex items-center gap-1.5 text-sm font-semibold" href={l.href}>
                      {l.label} <span class="arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    {/* ── Next project + contact ─────────────────────────────────── */}
    <nav class="wrap mt-20" aria-label="More projects">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        {
          next ? (
            <a href={`/projects/${next.id}/`} class="card group block p-6 md:p-8">
              <p class="eyebrow">Next project</p>
              <p class="mt-3 text-[1.35rem] font-semibold leading-snug tracking-tight" style="color: var(--ink);">
                {next.data.title}
              </p>
              <p class="mt-2 text-[0.95rem] leading-relaxed" style="color: var(--ink-2);">{next.data.tagline}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--accent);">
                Read it <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ) : (
            <a href="/#work" class="card group block p-6 md:p-8">
              <p class="eyebrow">That’s the last one</p>
              <p class="mt-3 text-[1.35rem] font-semibold leading-snug tracking-tight" style="color: var(--ink);">
                Back to all the work
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--accent);">
                See the list <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          )
        }
        <div class="flex flex-col justify-between gap-4 rounded-[var(--radius-lg)] border p-6 md:p-8" style="border-color: var(--rule); background: var(--paper-2);">
          <div>
            <p class="eyebrow">Hiring for this kind of work?</p>
            <p class="mt-3 text-[0.98rem] leading-relaxed" style="color: var(--ink-2);">Email is the fastest way to reach me.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href={`mailto:${site.email}`} class="btn btn-primary btn-sm">Email me</a>
            <a href={site.resume} class="btn btn-ghost btn-sm">Resume</a>
          </div>
        </div>
      </div>
      {prev && (
        <p class="mt-5 text-sm" style="color: var(--ink-3);">
          Previous: <a href={`/projects/${prev.id}/`} class="link">{prev.data.title}</a>
        </p>
      )}
    </nav>
  </article>
</Base>
