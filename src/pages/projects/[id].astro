---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Context', value: d.context },
  { label: 'Role', value: d.role },
  { label: 'Timeline', value: d.timeline },
];
---

<Base title={`${d.title} — ${site.name}`} description={d.summary}>
  <article>
    {/* ── Header ───────────────────────────────────────────────────── */}
    <header class="wrap pt-14 pb-12 md:pt-20">
      <a
        href="/projects"
        class="link-underline inline-flex items-center gap-1.5 text-sm font-medium"
        style="color: var(--ink-3);"
      >
        <span aria-hidden="true">&larr;</span> All work
      </a>

      <p class="eyebrow mt-8" style="color: var(--accent-ink);">{d.category}</p>
      <h1
        class="mt-4 max-w-3xl text-[2.125rem] leading-[1.12] tracking-[-0.02em] md:text-5xl"
        style="font-family: var(--font-display); color: var(--ink); font-weight: 400;"
      >
        {d.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: var(--ink-2);">
        {d.tagline}
      </p>

      <dl class="mt-10 grid gap-6 border-t pt-6 sm:grid-cols-3" style="border-color: var(--rule);">
        {
          facts.map((f) => (
            <div>
              <dt class="eyebrow">{f.label}</dt>
              <dd class="mt-2 text-sm leading-snug" style="color: var(--ink);">
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap gap-1.5">
        {d.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
    </header>

    {/* ── Metrics ──────────────────────────────────────────────────── */}
    {
      d.metrics.length > 0 && (
        <section class="wrap">
          <dl
            class="grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-3"
            style="border-color: var(--rule); background: var(--rule);"
          >
            {d.metrics.map((m) => (
              <div class="p-6" style="background: var(--paper-3);">
                <dd
                  class="text-3xl leading-none tracking-tight"
                  style="font-family: var(--font-mono); font-weight: 600; color: var(--accent-ink);"
                >
                  {m.value}
                </dd>
                <dt class="mt-3 text-[0.8125rem] leading-snug" style="color: var(--ink-2);">
                  {m.label}
                </dt>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {/* ── At a glance ──────────────────────────────────────────────── */}
    <section class="wrap mt-14">
      <div class="grid gap-8 rounded-2xl border p-7 md:grid-cols-3 md:p-9" style="border-color: var(--rule); background: var(--paper-2);">
        {
          (
            [
              ['Problem', d.glance.problem],
              ['Approach', d.glance.approach],
              ['Result', d.glance.result],
            ] as const
          ).map(([label, body]) => (
            <div>
              <p class="eyebrow" style="color: var(--accent-ink);">
                {label}
              </p>
              <p class="mt-3 text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">
                {body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ── Body ─────────────────────────────────────────────────────── */}
    <div class="wrap mt-16">
      <div class="mx-auto max-w-[42rem]">
        <div class="prose-case">
          <Content />
        </div>

        {
          d.links.length > 0 && (
            <div class="mt-14 border-t pt-6" style="border-color: var(--rule);">
              <p class="eyebrow">Links</p>
              <ul class="mt-4 space-y-2">
                {d.links.map((l) => (
                  <li>
                    <a class="link-underline text-sm font-medium" style="color: var(--accent-ink);" href={l.href}>
                      {l.label} &rarr;
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    {/* ── Prev / next ──────────────────────────────────────────────── */}
    <nav class="wrap mt-24">
      <div class="grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-2" style="border-color: var(--rule); background: var(--rule);">
        {
          [
            { entry: prev, dir: 'Previous' },
            { entry: next, dir: 'Next' },
          ].map(({ entry, dir }) =>
            entry ? (
              <a
                href={`/projects/${entry.id}`}
                class="group block p-7 transition-colors"
                style="background: var(--paper-3);"
                data-pn
              >
                <p class="eyebrow">{dir}</p>
                <p class="mt-2.5 text-lg leading-snug tracking-tight" style="font-family: var(--font-display); color: var(--ink);">
                  {entry.data.title}
                </p>
              </a>
            ) : (
              <div class="p-7" style="background: var(--paper-3);" />
            )
          )
        }
      </div>
    </nav>
  </article>
</Base>

<style>
  [data-pn]:hover {
    background: var(--paper-2) !important;
  }
</style>
