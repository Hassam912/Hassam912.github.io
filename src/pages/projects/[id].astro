---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { readTime } from '../../lib/readTime';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const minutes = readTime(project.body);

/* The fact box: answer-first, so a reader who stops here has the whole story. */
const facts: { label: string; value: string }[] = [
  { label: 'Result', value: d.result },
  ...(d.impact ? [{ label: 'Impact', value: d.impact }] : []),
  { label: 'My role', value: `${d.role} · ${d.team}` },
  { label: 'Context', value: d.context },
  { label: 'Timeframe', value: d.timeline },
];
---

<Base title={`${d.title} — ${site.name}`} description={d.summary} progress>
  <article>
    {/* ── Header: kicker, outcome title, TL;DR ────────────────────────── */}
    <header class="wrap pt-12 md:pt-16">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-1.5" style="color: var(--ink-3);">
          <li><a href="/#work" class="link">Work</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{d.category}</li>
        </ol>
      </nav>

      <p class="eyebrow mt-8">{d.category} <span aria-hidden="true">·</span> {d.context}</p>
      <h1
        class="mt-3 max-w-[48rem] text-[2rem] leading-[1.1] tracking-[-0.022em] md:text-[2.75rem]"
        style={`font-family: var(--font-display); color: var(--ink); font-weight: 650; view-transition-name: title-${project.id};`}
      >
        {d.title}
      </h1>
      <p class="mt-5 max-w-[42rem] text-[1.125rem] leading-relaxed md:text-[1.2rem]" style="color: var(--ink-2);">
        {d.tldr}
      </p>
      <p class="eyebrow mt-4">{minutes} min read</p>
    </header>

    {/* ── Fact box + metrics strip ─────────────────────────────────────── */}
    <section class="wrap mt-8" aria-label="Project facts">
      <div class="overflow-hidden rounded-[var(--radius-lg)] border" style="border-color: var(--rule); background: var(--paper-3);">
        <dl class="grid md:grid-cols-2">
          {
            facts.map((f, i) => (
              <div
                class:list={['fact grid gap-1 px-5 py-4 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-4 md:px-6', { 'md:col-span-2': i < 2 }]}
              >
                <dt class="eyebrow pt-0.5">{f.label}</dt>
                <dd class="text-[0.95rem] leading-relaxed" style={`color: var(--ink);${i === 0 ? ' font-weight: 600;' : ''}`}>
                  {f.value}
                </dd>
              </div>
            ))
          }
          <div class="fact grid gap-1 px-5 py-4 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-4 md:px-6">
            <dt class="eyebrow pt-1">Tools</dt>
            <dd class="flex flex-wrap gap-1.5">
              {d.stack.map((s) => <span class="chip">{s}</span>)}
            </dd>
          </div>
          <div class="fact grid gap-1 px-5 py-4 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-4 md:col-span-2 md:px-6">
            <dt class="eyebrow pt-0.5">Links</dt>
            <dd class="flex flex-col gap-1.5 text-[0.95rem]">
              {
                d.links.length > 0 ? (
                  d.links.map((l) => (
                    <a href={l.href} class="link inline-flex items-center gap-1.5 font-semibold">
                      {l.label} <span class="arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  ))
                ) : (
                  <span style="color: var(--ink-3);">Code and data available on request</span>
                )
              }
            </dd>
          </div>
        </dl>

        {
          d.metrics.length > 0 && (
            <dl
              class="metrics grid border-t"
              style={`border-color: var(--rule); background: var(--paper-2); --cols: ${d.metrics.length};`}
            >
              {d.metrics.map((m) => (
                <div class="flex flex-col gap-2 px-5 py-5 md:px-6">
                  <dd class="num text-[1.75rem] leading-none" style="color: var(--accent);">
                    {m.value}
                  </dd>
                  <dt class="text-[0.85rem] leading-snug" style="color: var(--ink-2);">
                    {m.label}
                  </dt>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </section>

    {/* ── Body ─────────────────────────────────────────────────────────── */}
    <div class="wrap mt-12">
      <div class="mx-auto max-w-[44rem]">
        <div class="prose-case">
          <Content />
        </div>
      </div>
    </div>

    {/* ── Next project + contact ───────────────────────────────────────── */}
    <nav class="wrap mt-20" aria-label="More projects">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        {
          next ? (
            <a href={`/projects/${next.id}/`} class="card group block p-6 md:p-8">
              <p class="eyebrow">Next case study</p>
              <p class="mt-3 text-[1.3rem] font-semibold leading-snug tracking-tight" style="color: var(--ink);">
                {next.data.title}
              </p>
              <p class="mt-3 flex flex-wrap items-baseline gap-x-2 text-[0.95rem]" style="color: var(--ink-2);">
                <span class="num" style="color: var(--accent);">{next.data.headline.value}</span>
                <span>{next.data.headline.label}</span>
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--accent);">
                Read it <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ) : (
            <a href="/#work" class="card group block p-6 md:p-8">
              <p class="eyebrow">That’s the last one</p>
              <p class="mt-3 text-[1.3rem] font-semibold leading-snug tracking-tight" style="color: var(--ink);">
                Back to all the work
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--accent);">
                See the list <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          )
        }
        <div class="flex flex-col justify-between gap-4 rounded-[var(--radius-lg)] border p-6 md:p-8" style="border-color: var(--rule); background: var(--paper-2);">
          <div>
            <p class="eyebrow">Hiring for this kind of work?</p>
            <p class="mt-3 text-[0.98rem] leading-relaxed" style="color: var(--ink-2);">Email is the fastest way to reach me.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href={`mailto:${site.email}`} class="btn btn-primary btn-sm">Email me</a>
            <a href={site.resume} class="btn btn-ghost btn-sm">Resume</a>
          </div>
        </div>
      </div>
      {
        prev && (
          <p class="mt-5 text-sm" style="color: var(--ink-3);">
            Previous: <a href={`/projects/${prev.id}/`} class="link">{prev.data.title}</a>
          </p>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .fact { border-top: 1px solid var(--rule); }
  dl > .fact:first-child { border-top: 0; }
  .metrics > div + div { border-top: 1px solid var(--rule); }
  @media (min-width: 640px) {
    .metrics { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .metrics > div + div { border-top: 0; border-left: 1px solid var(--rule); }
  }
</style>
