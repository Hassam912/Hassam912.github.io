---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, proof, credentials, toolkit, experience, education } from '../data/site';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const flagships = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);

/* The last word of the headline is set in the accent colour. */
const words = site.headline.split(' ');
const lastWord = words.pop();
const headStart = words.join(' ');
---

<Base>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="wrap pt-12 pb-10 md:pt-20 md:pb-14">
    <div class="max-w-[46rem]">
      <p class="rise eyebrow flex flex-wrap items-center gap-x-2.5 gap-y-1" style="--i: 0;">
        <span class="signal-dot" aria-hidden="true"></span>
        <span style="color: var(--ink);">{site.name}</span>
        <span aria-hidden="true">·</span>
        <span>{site.role}</span>
        <span aria-hidden="true">·</span>
        <span>Kitchener–Waterloo</span>
      </p>

      <h1
        class="rise mt-5 text-[2.4rem] leading-[1.04] tracking-[-0.025em] sm:text-[3.1rem] md:text-[3.75rem]"
        style="--i: 1; font-family: var(--font-display); color: var(--ink); font-weight: 700;"
      >
        {headStart} <span style="color: var(--accent);">{lastWord}</span>
      </h1>

      <p class="rise mt-5 max-w-[38rem] text-[1.0625rem] leading-relaxed md:text-[1.125rem]" style="--i: 2; color: var(--ink-2);">
        {site.subhead}
      </p>

      <div class="rise mt-7 flex flex-wrap items-center gap-3" style="--i: 3;">
        <a href="#work" class="btn btn-primary">See the work <span class="arrow" aria-hidden="true">&darr;</span></a>
        <a href={site.resume} class="btn btn-ghost">Download resume</a>
      </div>
      <p class="rise mt-5 text-sm" style="--i: 3; color: var(--ink-3);">
        {site.status} · <a href={`mailto:${site.email}`} class="link">{site.email}</a>
      </p>
    </div>
  </section>

  {/* ── Proof strip ──────────────────────────────────────────────────── */}
  <section class="wrap" aria-label="Results at a glance">
    <ul class="proof grid grid-cols-2 overflow-hidden rounded-[var(--radius-lg)] border lg:grid-cols-4" style="border-color: var(--rule); background: var(--paper-2);">
      {
        proof.map((p) => (
          <li class="min-w-0">
            <a href={p.href} class="proof-item group flex h-full flex-col gap-2 p-5 md:p-6">
              <span class="num text-[1.75rem] leading-none md:text-[2rem]" style="color: var(--accent);">
                {p.value}
              </span>
              <span class="text-[0.85rem] leading-snug" style="color: var(--ink-2);">
                {p.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-4">
      {
        credentials.map((c) => (
          <li class="min-w-0">
            <p class="text-[0.95rem] font-semibold leading-snug" style="color: var(--ink);">{c.name}</p>
            <p class="eyebrow mt-1">{c.sub}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── Selected work ────────────────────────────────────────────────── */}
  <section id="work" class="wrap mt-20 md:mt-28">
    <SectionHead
      eyebrow="Selected work"
      title="Four projects, strongest first."
      lede="Each one starts from a business question and ends with what changed. Every number traces to the case study."
    />
    <div class="mt-8 flex flex-col gap-6">
      {flagships.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  {/* ── More work ────────────────────────────────────────────────────── */}
  {
    more.length > 0 && (
      <section class="wrap mt-20 md:mt-24">
        <SectionHead eyebrow="More work" title="Coursework, a competition and the tools I’ve built." />
        <div class="mt-4 border-b" style="border-color: var(--rule);">
          {more.map((p) => (
            <ProjectCard project={p} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  {/* ── Experience & education ───────────────────────────────────────── */}
  <section id="experience" class="wrap mt-20 md:mt-28">
    <SectionHead eyebrow="Experience" title="Where I’ve done the work." />
    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16">
      <ol class="flex flex-col">
        {
          experience.map((x) => (
            <li class="grid gap-1 border-t py-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6" style="border-color: var(--rule);">
              <p class="eyebrow pt-0.5">{x.period}</p>
              <div class="min-w-0">
                <p class="text-[1rem] font-semibold leading-snug" style="color: var(--ink);">
                  {x.title} <span style="color: var(--ink-3); font-weight: 500;">· {x.company}</span>
                </p>
                <p class="mt-1.5 text-[0.9375rem] leading-relaxed" style="color: var(--ink-2);">{x.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div>
        <p class="eyebrow border-t pt-5" style="border-color: var(--rule);">Education</p>
        <ul class="mt-4 flex flex-col gap-5">
          {
            education.map((e) => (
              <li>
                <p class="text-[0.98rem] font-semibold leading-snug" style="color: var(--ink);">{e.credential}</p>
                <p class="mt-1 text-sm" style="color: var(--ink-2);">{e.school}</p>
                <p class="eyebrow mt-1.5">{e.period} · {e.detail}</p>
              </li>
            ))
          }
        </ul>
        <a href={site.resume} class="link mt-6 inline-flex items-center gap-1.5 text-sm font-semibold">
          Full resume (PDF) <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  {/* ── Toolkit ──────────────────────────────────────────────────────── */}
  <section class="wrap mt-20 md:mt-28">
    <SectionHead eyebrow="Toolkit" title="What I use, grouped by what it’s for." />
    <div class="mt-8 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border sm:grid-cols-2" style="border-color: var(--rule); background: var(--rule);">
      {
        toolkit.map((t) => (
          <div class="p-6" style="background: var(--paper-3);">
            <h3 class="text-[0.95rem] font-semibold" style="color: var(--ink);">{t.group}</h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {t.items.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── The short version ────────────────────────────────────────────── */}
  <section class="wrap mt-20 md:mt-28">
    <div class="grid gap-6 border-t pt-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10" style="border-color: var(--rule);">
      <p class="eyebrow md:pt-1.5">The short version</p>
      <div class="max-w-2xl">
        <div class="prose-case" style="font-size: 1.0625rem;">
          <p>
            I came into analytics through operations: three years of support and billing work where I
            kept hitting the same wall. The data existed, but nobody had built anything that would
            <em>act</em> on it. So I started building. A fractional-billing system that processed close to $1M a month.
            An HR agent that writes its own documents. A browser agent that fills in forms by itself.
          </p>
          <p>
            Now I’m finishing a Master of Management Analytics at Queen’s, which gave me the formal half
            (optimization, inference, machine learning) to go with the engineering half. In between I
            co-founded <strong>Hopefield Home</strong>, a home-textiles brand, mostly because I wanted a business where
            I owned every number and couldn’t hide behind someone else’s dashboard.
          </p>
        </div>
        <a href="/about/" class="link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold">
          More about me <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .proof li + li { border-left: 1px solid var(--rule); }
  .proof li:nth-child(3) { border-left: 0; }
  .proof li:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  @media (min-width: 1024px) {
    .proof li:nth-child(3) { border-left: 1px solid var(--rule); }
    .proof li:nth-child(n + 3) { border-top: 0; }
  }
  .proof-item { transition: background-color var(--t-base) var(--ease); }
  .proof-item:hover { background: var(--paper-3); }
</style>
