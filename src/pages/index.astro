---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCloud from '../components/SkillCloud.astro';
import { site, toolkit } from '../data/site';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = all.filter((p) => p.data.featured).slice(0, 4);
const rest = all.filter((p) => !p.data.featured);
const headlineLines = site.headline.split('\n');
---

<Base>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="wrap pt-14 pb-12 md:pt-20 md:pb-16">
    <div class="rise grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      {/* Left — the pitch */}
      <div>
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
              style="background: var(--accent);"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full" style="background: var(--accent);"
            ></span>
          </span>
          <p class="eyebrow">{site.status}</p>
        </div>

        <h1
          class="mt-6 text-[2.25rem] leading-[1.06] tracking-[-0.03em] sm:text-5xl md:text-[3.25rem]"
          style="font-family: var(--font-display); color: var(--ink); font-weight: 800;"
        >
          {
            headlineLines.map((line, i) => (
              <span class="block">
                {i === headlineLines.length - 1 ? (
                  <span style="color: var(--accent);">{line}</span>
                ) : (
                  line
                )}
              </span>
            ))
          }
        </h1>

        <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed" style="color: var(--ink-2);">
          {site.subhead}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#work"
            class="rounded-full px-7 py-3.5 text-[0.9375rem] font-semibold text-white transition-all"
            style="background: linear-gradient(135deg, #fb923c, #ea580c); box-shadow: var(--shadow-lift);"
            data-cta>See the work</a
          >
          <a
            href={site.resume}
            class="rounded-full border px-7 py-3.5 text-[0.9375rem] font-semibold transition-colors"
            style="border-color: var(--accent-border); background: var(--paper-3); color: var(--accent-ink);"
            data-ghost>Download résumé</a
          >
        </div>
        <a
          href={`mailto:${site.email}`}
          class="link-underline mt-5 inline-block text-sm font-medium"
          style="color: var(--ink-2);">{site.email}</a
        >
      </div>

      {/* Right — the toolkit as a living word cloud */}
      <div>
        <h2
          class="text-center text-[1.125rem] leading-tight tracking-tight md:text-[1.25rem]"
          style="font-family: var(--font-display); color: var(--ink); font-weight: 700;"
        >
          What I work with
        </h2>
        <SkillCloud />
        <p class="text-center text-[0.8125rem]" style="color: var(--ink-3);">
          Never all of it at once — the list keeps rotating.
        </p>
      </div>
    </div>
  </section>

  {/* ── Credentials ──────────────────────────────────────────────────── */}
  <section class="wrap pb-14">
    <div class="border-t pt-6" style="border-color: var(--rule);">
      <p class="eyebrow">Where the work comes from</p>
      <div class="mt-4 grid gap-x-10 gap-y-4 sm:grid-cols-3">
        {
          [
            ['Smith School of Business', 'Queen’s University · MMA'],
            ['Cowlar Design Studio', 'Y Combinator–backed'],
            ['Hopefield', 'my own brand'],
          ].map(([name, sub]) => (
            <div>
              <p class="text-[0.9375rem] font-semibold leading-snug tracking-tight" style="color: var(--ink);">
                {name}
              </p>
              <p class="eyebrow mt-1.5">{sub}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Featured work ────────────────────────────────────────────────── */}
  <section id="work" class="wrap mt-28 scroll-mt-20 md:mt-36">
    <SectionHead
      eyebrow="Selected work"
      title="Four projects that show the whole arc — question, model, decision, result."
      lede="Each one started with a business problem someone actually had. Two of them are running in production right now."
      href="/projects"
      hrefLabel="All work"
    />

    {/* Jump-nav: names first, then click straight to the card. Sticks below
        the site header so it stays reachable through the full-height cards. */}
    <nav class="project-nav" aria-label="Jump to a project">
      <span class="eyebrow shrink-0">Jump to</span>
      <ul class="project-nav-list">
        {
          featured.map((p) => (
            <li>
              <a href={`#project-${p.id}`} class="project-nav-link" data-jump={`project-${p.id}`}>
                {p.data.navLabel ?? p.data.category}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-8 flex flex-col gap-6">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>

    <script>
      /* Light-touch scrollspy: mark whichever card is nearest the middle of
         the viewport so the jump-nav always says where you are. */
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-jump]')];
      const cards = links
        .map((l) => document.getElementById(l.dataset.jump!))
        .filter((el): el is HTMLElement => !!el);

      /* Drive the jump ourselves. A plain hash jump obeys scroll-margin-top
         while scroll-snap wants the card centred, and the two disagree — which
         left the first cards parked short of the viewport. */
      links.forEach((l) =>
        l.addEventListener('click', (e) => {
          const target = document.getElementById(l.dataset.jump!);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ block: 'center', behavior: 'smooth' });
          history.replaceState(null, '', `#${l.dataset.jump}`);
        })
      );

      if (links.length && cards.length && 'IntersectionObserver' in window) {
        const setActive = (id: string) =>
          links.forEach((l) => l.classList.toggle('is-active', l.dataset.jump === id));

        const io = new IntersectionObserver(
          (entries) => {
            const mid = innerHeight / 2;
            let best: { id: string; d: number } | null = null;
            for (const c of cards) {
              const r = c.getBoundingClientRect();
              if (r.bottom < 0 || r.top > innerHeight) continue;
              const d = Math.abs(r.top + r.height / 2 - mid);
              if (!best || d < best.d) best = { id: c.id, d };
            }
            if (best) setActive(best.id);
          },
          { threshold: [0, 0.25, 0.5, 0.75, 1] }
        );
        cards.forEach((c) => io.observe(c));
      }
    </script>
  </section>

  {/* ── Secondary work ───────────────────────────────────────────────── */}
  {
    rest.length > 0 && (
      <section class="wrap mt-28 md:mt-36">
        <SectionHead
          eyebrow="Also in the portfolio"
          title="Coursework, competitions and tools I’ve built."
          lede="Shorter write-ups — same structure, less depth."
        />
        <div class="mt-4">
          {rest.map((p) => (
            <ProjectCard project={p} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  {/* ── Toolkit ──────────────────────────────────────────────────────── */}
  <section class="wrap mt-28 md:mt-36">
    <SectionHead
      eyebrow="Toolkit"
      title="What I reach for."
      lede="Grouped by what it’s for, not by how long the list is."
    />
    <div
      class="mt-10 grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-2"
      style="border-color: var(--rule); background: var(--rule);"
    >
      {
        toolkit.map((t) => (
          <div class="p-7" style="background: var(--paper-3);">
            <h3 class="text-[0.9375rem] font-semibold tracking-tight" style="color: var(--ink);">
              {t.group}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {t.items.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Bio ──────────────────────────────────────────────────────────── */}
  <section class="wrap mt-28 md:mt-36">
    <div
      class="grid gap-10 border-t pt-6 md:grid-cols-[auto_1fr] md:gap-16"
      style="border-color: var(--rule);"
    >
      <p class="eyebrow md:pt-1">The short version</p>
      <div class="max-w-2xl">
        <div class="prose-case" style="font-size: 1.125rem;">
          <p>
            I came into analytics through operations — three years of support and billing work where I
            kept hitting the same wall: the data existed, but nobody had built anything that would
            <em>act</em> on it. So I started building. A fractional-billing system that now runs real money.
            An HR agent that writes its own documents. A browser agent that fills in forms by itself.
          </p>
          <p>
            Now I’m finishing a Master of Management Analytics at Queen’s, which gave me the formal half —
            optimization, inference, machine learning — to go with the engineering half. In between I
            started <strong>Hopefield</strong>, a home-textiles brand, mostly because I wanted a business where
            I owned every number and couldn’t hide behind someone else’s dashboard.
          </p>
          <p>
            That’s the thread: I like problems where the answer has to survive contact with a real
            constraint — a budget, a warehouse, a solver, a customer.
          </p>
        </div>
        <a
          href="/about"
          class="link-underline mt-6 inline-block text-sm font-medium"
          style="color: var(--accent-ink);">More about me &rarr;</a
        >
      </div>
    </div>
  </section>
</Base>

<style>
  [data-ghost]:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  [data-cta]:hover {
    transform: translateY(-2px);
    filter: saturate(1.08);
  }
  [data-pill]:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift) !important;
  }

</style>
